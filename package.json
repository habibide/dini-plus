{
  "name": "dini",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @dini/web",
    "dev:mobile": "npm run start -w @dini/mobile",
